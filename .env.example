# @BotFather dan olingan token
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# SUPER ADMIN — faqat bitta Telegram ID (bir nechta yozilsa, faqat birinchisi olinadi).
# Adminlarni super admin bot/ilova orqali tayinlaydi. ID ni bilish: botga /id yozing yoki @userinfobot
ADMIN_IDS=123456789

# Ixtiyoriy sozlamalar
TIMEZONE=Asia/Tashkent
# Har kuni shu soatda qisqa hisobot yuboriladi (-1 = o'chirish)
REPORT_HOUR=9
# Birinchi ishga tushishda qo'shiladigan valyutalar (keyin admin paneldan o'zgartiriladi)
CURRENCIES=UZS,USD,EUR,RUB
# DB_PATH=data/expenses.db

# Mini App: tashqi HTTPS manzil. Bo'sh bo'lsa ilova tugmasi chiqmaydi
WEBAPP_URL=
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Valyuta kurslari: https://app.exchangerate-api.com dan olingan kalit (ixtiyoriy, CBU ochilmasa ishlatiladi)
EXCHANGERATE_API_KEY=
